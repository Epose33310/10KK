# ==========================================================================
# Serveur Apache d'IONOS — compression, cache et petites règles de propreté.
#
# Tout est encadré par des <IfModule> : si un module manque sur l'hébergement,
# la règle est simplement ignorée au lieu de casser le site.
# ==========================================================================

# --- Compression ----------------------------------------------------------
# Les pages, la feuille de style et les scripts partent compressés. Les JPEG,
# les MP4 et les WOFF2 le sont déjà : les recompresser ne gagnerait rien.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml application/xml
</IfModule>

# --- Cache navigateur -----------------------------------------------------
# Le site pèse une vingtaine de mégaoctets, presque entièrement des vidéos et
# des photos. Sans ces règles, un visiteur les retélécharge à chaque visite.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"

  # Le HTML n'est jamais mis en cache : c'est lui qui porte les ?v=NN et donc
  # lui qui doit annoncer les nouvelles versions des autres fichiers.
  ExpiresByType text/html "access plus 0 seconds"

  # La feuille de style et les scripts sont appelés avec ?v=NN : une version
  # publiée = une adresse différente. On peut les garder un an sans risque.
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"

  # Les médias n'ont pas de numéro de version : un mois, pour qu'un fichier
  # remplacé sous le même nom finisse par ressortir.
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType video/mp4 "access plus 1 month"
  ExpiresByType video/webm "access plus 1 month"

  # Le dossier de présentation change plus souvent que les photos.
  ExpiresByType application/pdf "access plus 1 week"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# --- Types servis correctement -------------------------------------------
# Un WOFF2 ou un WebM annoncé avec le mauvais type n'est pas lu par tous les
# navigateurs, et perd son cache.
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType video/webm .webm
  AddType video/mp4  .mp4
</IfModule>

# --- Les sources ne sont pas un contenu public ----------------------------
# tools/ contient les générateurs de pages et les gabarits HTML des PDF :
# utiles dans le dépôt, sans objet sur le serveur.
<IfModule mod_alias.c>
  RedirectMatch 404 ^/tools/
  RedirectMatch 404 ^/\.github/
</IfModule>
